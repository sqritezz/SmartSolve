  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed245da2d36b4c04a87801b7e8b99d8f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  stepText: {fileID: 252043997}
  visualPanel: {fileID: 0}
  groups:
  - objectives:
    - First, speak to the NPC.
  - objectives:
    - Open the PC Monitor by pressing the power button (see if it open).
  - objectives:
    - Turn off the PSU's switch.
  - objectives:
    - 'Go to the side of system unit, and open the cover. '
  - objectives:
    - Remove the dirty RAM.
  - objectives:
    - Use your other hand to grab the eraser and clean the RAM.
    - Find the correct slot to place the RAM.
  - objectives:
    - Turn on the PSU's switch.
  - objectives:
    - Click the power button again to see if its working now.
  - objectives:
    - If its still not working, turn off the PSU's switch again.
  - objectives:
    - Remove the RAM and throw it in the trash bin.
  - objectives:
    - Try replacing the RAM module by grabbing the RAM on the table.
    - Find the correct slot.
  - objectives:
    - Close the system unit's cover.
  - objectives:
    - Turn on the PSU's switch.
    - Click the power button again.
  checkmarkSymbol: "\u2714"
  normalColorHex: '#FFFFFF'
  completedColorHex: '#00FF00'
  delayBeforeNextGroup: 1.2
  onAllStepsComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 990833280}
        m_TargetAssemblyTypeName: LevelCompleteManager, Assembly-CSharp
        m_MethodName: ShowRewardScreen
        m_Mode: 1
        m_Arguments:
