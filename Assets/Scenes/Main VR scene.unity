  m_Script: {fileID: 11500000, guid: 03d661b1a2109704197f7de42295ee9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  isActiveDialogue: 0
  lines:
  - 'Hello, again! '
  - 'Good job for passing the first level, I hope you pass this too. '
  - "I think another problem arouse my PC again \u2014 nothing is turning on. I don't
    know why. "
  - Can you take a look and figure out what's causing it?
  - "Check the PSU  \u2014 the culprit might be there again."
  - Before you proceed in troubleshooting, don't forget to turn off the psu's switch
    for safety purposes.
  - 'Follow the objectives and complete the level. '
  - Good luck!
  dialoguePanel: {fileID: 423678905}
  dialogueText: {fileID: 1699654500}
  speakerNameText: {fileID: 898522496}
  speakerName: Azer
  animator: {fileID: 1303257912}
