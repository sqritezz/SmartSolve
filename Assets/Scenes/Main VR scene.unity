  m_Script: {fileID: 11500000, guid: ed245da2d36b4c04a87801b7e8b99d8f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  stepText: {fileID: 261595208}
  visualPanel: {fileID: 0}
  groups:
  - objectives:
    - First, speak to the NPC.
  - objectives:
    - Open the PC Monitor by clicking the power button (see if it open).
  - objectives:
    - Press the power button.
  - objectives:
    - Turn off the switch on the old PSU.
  - objectives:
    - Open the side cover.
  - objectives:
    - Unplug the old 24-pin.
  - objectives:
    - Go to the back of the PSU and unscrew the 4 screws.
  - objectives:
    - Pull out the old PSU.
  - objectives:
    - Grab the new PSU and place it in the bay.
  - objectives:
    - Screw the 4 screws back in.
  - objectives:
    - Plug the new PSU's 24-pin into the motherboard.
  - objectives:
    - Close the side cover.
  - objectives:
    - Turn on the switch on the new PSU.
  - objectives:
    - Press the power button.
  checkmarkSymbol: "\u2714"
  normalColorHex: '#FFFFFF'
  completedColorHex: '#00FF00'
  delayBeforeNextGroup: 1.2
  onAllStepsComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1179845605}
        m_TargetAssemblyTypeName: LevelCompleteManager, Assembly-CSharp
        m_MethodName: ShowRewardScreen
