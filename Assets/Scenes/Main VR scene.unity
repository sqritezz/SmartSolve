  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed245da2d36b4c04a87801b7e8b99d8f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  stepText: {fileID: 471097502}
  visualPanel: {fileID: 0}
  groups:
  - objectives:
    - First, speak to the NPC.
  - objectives:
    - Open the PC Monitor by clicking the power button (see if it open).
  - objectives:
    - Turn off the PSU's switch.
  - objectives:
    - 'Go to the side of CPU case, and open the cover by clicking it. '
  - objectives:
    - Remove the 24-pin connector.
  - objectives:
    - Bend the paperclip with the pliers.
  - objectives:
    - Insert the paperclip into the green and black holes (below the green).
  - objectives:
    - Turn on the PSU's switch to see if it's working.
  - objectives:
    - Turn off the PSU's switch and remove the paperclip.
  - objectives:
    - Plug the 24-pin back in.
  - objectives:
    - Move the power switch plug to pins 6 and 8.
  - objectives:
    - Close the side cover.
  - objectives:
    - Turn on the PSU's switch.
  - objectives:
    - Press the power button again.
  checkmarkSymbol: "\u2714"
  normalColorHex: '#FFFFFF'
  completedColorHex: '#00FF00'
  delayBeforeNextGroup: 1.2
  onAllStepsComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1104750703}
        m_TargetAssemblyTypeName: LevelCompleteManager, Assembly-CSharp
        m_MethodName: ShowRewardScreen
        m_Mode: 1
