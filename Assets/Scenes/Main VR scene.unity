  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03d661b1a2109704197f7de42295ee9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  isActiveDialogue: 0
  lines:
  - 'Hello, again! '
  - 'Great job! You''re now in the final level of stage RAM. '
  - This will be the hardest level you will take for the last round.
  - "I need your help again, because another problem arouse in my PC again \u2014
    it was beeping when I opened it.  "
  - 'I followed what you did in the previous level, but it''s still not working. '
  - Can you help me and take a look to figure out what's causing it?
  - Try to check the CPU's case one last time to see the problem.
  - Before you proceed in troubleshooting, don't forget to turn off the psu's switch
    first for safety purposes.
  - 'Follow the objectives and complete the level. '
  - Good luck!
  dialoguePanel: {fileID: 1398309591}
  dialogueText: {fileID: 2031034383}
  speakerNameText: {fileID: 1374456493}
  speakerName: Azer
  animator: {fileID: 1288135533353594867}
  talkTriggerName: Talk
  idleTriggerName: Idle
  checklist: {fileID: 1688260391}
  groupIndex: 0
  objectiveIndex: 0
  psuSwitchToUnlock: {fileID: 222031705}
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 990833282}
        m_TargetAssemblyTypeName: PerformanceTracker, Assembly-CSharp
        m_MethodName: StartTracking
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
