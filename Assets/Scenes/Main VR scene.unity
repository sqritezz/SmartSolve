  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03d661b1a2109704197f7de42295ee9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  isActiveDialogue: 0
  lines:
  - 'Hello, I am Azer. Your dearest friend! '
  - "Welcome to SmartSolve VR: A Virtual Reality\u2013Based Simulator Game for Computer
    Hardware Troubleshooting Training. "
  - "Hey! I think something's wrong with this PC \u2014 it won't boot properly."
  - Can you take a look and figure out what's causing it?
  - "Check the inside of System Unit  \u2014 the culprit might be there."
  - Before you proceed in troubleshooting, don't forget to turn off the psu's switch
    first for safety purposes.
  - 'Follow the objectives and complete the level. '
  - Good luck!
  dialoguePanel: {fileID: 653248753}
  dialogueText: {fileID: 1920757320}
  speakerNameText: {fileID: 713857210}
  speakerName: Azer
  animator: {fileID: 1288135533353594867}
  talkTriggerName: Talk
  idleTriggerName: Idle
  checklist: {fileID: 1767544737}
  groupIndex: 0
  objectiveIndex: 0
  psuSwitchToUnlock: {fileID: 6172990524742320734}
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 337014841}
        m_TargetAssemblyTypeName: PerformanceTracker, Assembly-CSharp
        m_MethodName: StartTracking
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
