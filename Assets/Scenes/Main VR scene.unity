  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58fb7818407ae07408994aa0934587f9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  checklist: {fileID: 1688260391}
  explanations:
  - afterGroupIndex: 1
    delay: 2
    title: The PC shut down again
    why: 'The computer beep. This points to a RAM problem: it may be dirty, loose
      or damaged.'
    howToFix: Turn off the PSU switch and open the side cover. Remove the RAM and
      clean its gold contacts with the eraser, then put it back and test the PC again.
  - afterGroupIndex: 7
    delay: 2
    title: The RAM is faulty
    why: "You cleaned and reseated the RAM, but the PC still won\u2019t start. That
      means the RAM module itself is damaged, and cleaning can\u2019t fix a broken
      chip."
    howToFix: 
  - afterGroupIndex: 9
    delay: 2
    title: Getting rid of old parts
    why: "A faulty RAM stick can\u2019t be repaired, so it shouldn\u2019t stay mixed
      with your working parts. In real life, don\u2019t throw electronics in normal
      trash. Bring old parts to an e-waste drop-off or recycling center."
    howToFix: 
