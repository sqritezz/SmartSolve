  m_Name: 
  m_EditorClassIdentifier: '::'
  stepText: {fileID: 734589201}
  groups:
  - objectives:
    - Open the PC Monitor by clicking the power button (see if it open).
    - 'Go to the side of CPU case, and open the cover lid by clicking it. '
  - objectives:
    - Remove the dirty RAM.
    - Grab the eraser and clean the RAM.
    - Place the RAM in any slot
  - objectives:
    - Click the power button again. (If its still not working try to use RAM on the
      table)
    - Grab the RAM on the table.
    - Find the correct slot to place RAM
    - Close the CPU lid.
    - Click the power button again.
  checkmarkSymbol: "\u2714"
  normalColorHex: '#FFFFFF'
  completedColorHex: '#00FF00'
  delayBeforeNextGroup: 1.2
  onAllStepsComplete:
    m_PersistentCalls:
