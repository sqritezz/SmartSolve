  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03d661b1a2109704197f7de42295ee9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  isActiveDialogue: 0
  lines:
  - You're now moving on to the real level. Let's move to the next problem.
  - "Hey! I think something's wrong with this PC \u2014 it was suddenly keeps restarting
    or shutting down. "
  - Can you take a look and figure out what's causing it?
  - "Check the PSU  \u2014 the problem might be there."
  - Before you proceed in troubleshooting, don't forget to turn off the psu's switch
    for safety purposes.
  - 'Follow the objectives and complete the level. '
  - Good luck!
  dialoguePanel: {fileID: 614912053}
  dialogueText: {fileID: 1280960633}
  speakerNameText: {fileID: 15607993}
  speakerName: Azer
  animator: {fileID: 1429677056}
  talkTriggerName: Talk
  idleTriggerName: Idle
  checklist: {fileID: 149826874}
  groupIndex: 0
  objectiveIndex: 0
  psuSwitchToUnlock: {fileID: 1134944776}
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
